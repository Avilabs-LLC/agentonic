Table agentonic.evaluation_preparations {
 confirmed_revision integer
 id uuid [pk, not null]
 workspace_id uuid [not null]
 agent_id uuid [not null]
 submission_id uuid [not null]
 code_release_id uuid [not null]
 configuration_release_id uuid [not null]
 authorized_by_member_id uuid [not null]
 request_id uuid [not null]
 configuration_sha256 text [not null]
 requested_access_sha256 text [not null]
 budget_usd numeric(20,8) [not null]
 committed_microusd bigint [not null, default: 0]
 status text [not null, default: 'queued']
 generated_criteria jsonb [not null, note: 'Immutable AI proposal. Migration 20 exposes key/question/expectedAnswer for summary edit comparison only while review authorization and sources remain live.']
 criteria jsonb [not null, note: 'Migration 19 adds per-situation reviewDecision: pending, approved or not_applicable. Customer confirmation requires every situation decided and at least one approved.']
 revision integer [not null, default: 0]
 source_snapshot jsonb [not null]
 risk text [not null, default: 'uncertain']
 evaluation_id uuid
 worker_id uuid
 lease_token uuid
 lease_until timestamptz
 confirmed_at timestamptz
 consent_revoked_at timestamptz
 scrubbed_at timestamptz
 expires_at timestamptz [not null]
 created_at timestamptz [not null]
 started_at timestamptz
 finished_at timestamptz
 indexes {
  (workspace_id,id) [unique]
  (workspace_id,authorized_by_member_id,request_id) [unique]
 }
 Note: 'Implemented migration 17. Customer consent precedes AI preparation. Migration 35 separates preparation budget, criteria confirmation and individually authorized evaluation batches. Editing current criteria creates a new revision and clears confirmation; immutable run snapshots and historical consumption remain unchanged. Scoped SECURITY DEFINER APIs only; no direct app/worker grants. Automatic approval requires exact passing Azure evidence, routine read-only scope and no exclusions.'
}
Table agentonic.evaluation_criteria_revisions {
 id uuid [pk, not null]
 workspace_id uuid [not null]
 preparation_id uuid [not null]
 revision integer [not null]
 criteria jsonb [not null]
 content_sha256 text [not null]
 edited_by_member_id uuid [not null]
 created_at timestamptz [not null]
 scrubbed_at timestamptz
 indexes { (preparation_id,revision) [unique] }
 Note: 'Immutable customer edits, per-situation decisions and generation revision 0. Narrow content erasure after cancellation/expiry preserves hashes and editor provenance. Existing confirmed evidence is not rewritten by migration 19.'
}
Ref: agentonic.evaluation_preparations.(workspace_id,agent_id,code_release_id,configuration_release_id,submission_id) > agentonic.agent_submissions.(workspace_id,agent_id,code_release_id,configuration_release_id,id)
Ref: agentonic.evaluation_preparations.(workspace_id,authorized_by_member_id) > agentonic.workspace_members.(workspace_id,id)
Ref: agentonic.evaluation_preparations.worker_id > agentonic.evaluation_workers.id
Ref: agentonic.evaluation_preparations.(workspace_id,evaluation_id) > agentonic.evaluation_runs.(workspace_id,id)
Ref: agentonic.evaluation_runs.(workspace_id,preparation_id) > agentonic.evaluation_preparations.(workspace_id,id)
Ref: agentonic.evaluation_criteria_revisions.(workspace_id,preparation_id) > agentonic.evaluation_preparations.(workspace_id,id)
Ref: agentonic.evaluation_criteria_revisions.(workspace_id,edited_by_member_id) > agentonic.workspace_members.(workspace_id,id)

// Implemented staging-specific Gmail slice (migration 29). The generic target
// connections/tool_invocations model above remains the production destination.
Table agentonic.gmail_connections {
 id uuid [pk]
 workspace_id uuid [not null]
 agent_id uuid [not null]
 owner_member_id uuid [not null]
 account text [not null]
 status text [not null]
 credential_ciphertext text
 operations jsonb [not null]
 created_at timestamptz [not null]
 indexes { (workspace_id,agent_id,id) [unique] }
 Note: 'Owner-only staging account. Authenticated ciphertext; decryption key outside DB. No direct application table grants. Frozen scope intersects live operations.'
}
Table agentonic.gmail_oauth_states {
 state_hash text [pk]
 workspace_id uuid [not null]
 agent_id uuid [not null]
 owner_member_id uuid [not null]
 connection_id uuid [not null, unique]
 verifier_ciphertext text [not null]
 expires_at timestamptz [not null]
 consumed_at timestamptz
 finished_at timestamptz
 Note: 'One-use OAuth state, PKCE and verified actor/browser binding; no raw authorization codes stored.'
}
Table agentonic.gmail_invocations {
  execution_context text [not null, default: 'staging', note: 'staging or preview; conversation_id identifies that private session']
 id uuid [pk]
 workspace_id uuid [not null]
 agent_id uuid [not null]
 connection_id uuid [not null]
 owner_member_id uuid [not null]
 turn_id uuid [not null]
 conversation_id uuid [not null]
 operation text [not null]
 arguments_ciphertext text
 arguments_sha256 text [not null]
 status text [not null]
 created_at timestamptz [not null]
 expires_at timestamptz [not null]
 approved_at timestamptz
 finished_at timestamptz
 result jsonb
 Note: 'Durable exact-argument one-use write approval and result; pending/executing/succeeded/failed/uncertain/cancelled/expired. No automatic replay of uncertain writes. Private arguments erased independently of content-free audit.'
}
Ref: agentonic.gmail_connections.(workspace_id,agent_id) > agentonic.agents.(workspace_id,id)
Ref: agentonic.gmail_connections.(workspace_id,owner_member_id) > agentonic.workspace_members.(workspace_id,id)
Ref: agentonic.gmail_oauth_states.(workspace_id,agent_id) > agentonic.agents.(workspace_id,id)
Ref: agentonic.gmail_oauth_states.(workspace_id,owner_member_id) > agentonic.workspace_members.(workspace_id,id)
Ref: agentonic.gmail_invocations.(workspace_id,agent_id,connection_id) > agentonic.gmail_connections.(workspace_id,agent_id,id)
Ref: agentonic.gmail_invocations.(workspace_id,owner_member_id) > agentonic.workspace_members.(workspace_id,id)

// Browserbase public web slice (migration 31): requested_access.tools accepts a
// platform grant {capability:"web",operations:["web.search","web.read"]} alongside
// an optional Gmail grant. No OAuth connection row is created for web access.
// Existing code_tools/configuration_tools index the frozen web-v1 operations.
// retrieval_provider_budgets includes browserbase; provider operations reserve
// conservative per-call overage estimates without storing search/page content.
// Migration 32 changes only functions: new webResearch runtimes declare an eight-call
// registry ceiling; existing immutable code_tools rows retain their original three.
// web_meter derives the limit from the preview/deployment's pinned code release.

Ref: agentonic.evaluation_batches.(workspace_id,preparation_id) > agentonic.evaluation_preparations.(workspace_id,id)
Ref: agentonic.evaluation_runs.(workspace_id,batch_id) > agentonic.evaluation_batches.(workspace_id,id)
