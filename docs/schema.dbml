Table agentonic.retrieval_provider_budgets {
  provider text [pk, not null, check: `provider IN ('voyage','openai')`]
  cap_microusd bigint [not null, default: 0, check: `cap_microusd >= 0`]
  committed_microusd bigint [not null, default: 0, check: `committed_microusd >= 0`]
  updated_at timestamptz [not null, default: `now()`]
  Note: '''SCOPE: LAUNCH. Implemented operational development ceiling, global per provider. Lock before reserving each call. Includes known list-price estimates plus full uncertain reservations. Initial caps zero until explicitly configured. Not customer billing, not workspace/agent budget enforcement. Local previews add a per-preview ceiling under these existing totals. Integrate with budget_periods before hosted customer runtime launch, without resetting already consumed spend.'''
}
Table agentonic.retrieval_provider_operations {
  preview_id uuid [note: 'Opaque attribution retained after ephemeral preview erasure.']
  agent_id uuid [note: 'Opaque attribution, set only for agent preview operations.']
  id uuid [pk, not null]
  job_id uuid [not null, note: 'Opaque operation provenance without FK so content-bearing jobs can be purged.']
  workspace_id uuid [not null]
  provider text [not null]
  model text [not null]
  reserved_microusd bigint [not null, check: `reserved_microusd > 0`]
  actual_microusd bigint [check: `actual_microusd >= 0`]
  input_tokens bigint [check: `input_tokens >= 0`]
  output_tokens bigint [check: `output_tokens >= 0`]
  status text [not null, default: 'reserved', check: `status IN ('reserved','settled')`]
  created_at timestamptz [not null, default: `now()`]
  Note: '''SCOPE: LAUNCH. One reservation per external attempt; successful usage settles once using verified list prices, not provider invoice evidence. Unknown calls retain full reserve until manually reconciled. No document titles, text, prompts or credentials. Retained after document purge. Future usage_events import must deduplicate by this operation ID, not count both ledgers.'''
}
