  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  workspace                   Workspace           @relation("ContactWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contacts_relation_28_fk")
  linkedUser                  User?               @relation("ContactLinkedUser", fields: [linkedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contacts_relation_29_fk")
