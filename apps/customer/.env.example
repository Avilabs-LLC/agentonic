NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
DATABASE_URL="postgresql://agentonic_customer.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?schema=agentonic"
AGENTONIC_DATABASE_ROLE="agentonic_customer"
AGENTONIC_DATABASE_CA_FILE="/absolute/path/to/verified/supabase-ca.crt"

# Optional mobile access through one authenticated HTTPS development tunnel.
# Development only; restart the customer dev server after changing this URL.
# AGENTONIC_CUSTOMER_DEV_ORIGIN=https://YOUR-TUNNEL-3101.REGION.devtunnels.ms

# Gmail account connection (server-only). Use scripts/setup-gmail.mjs locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3101/api/connections/google/callback
# 32 random bytes, hex encoded. Preserve outside Git; shared only with trusted Gmail brokers.
AGENTONIC_CONNECTION_KEY=
# Only during a key rotation (pnpm connections:rotate-key): keys that still open older values.
# AGENTONIC_CONNECTION_STANDBY_KEYS=
