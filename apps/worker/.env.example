# Server-only worker configuration; never copy secret keys into the web apps.
DATABASE_URL=
AGENTONIC_DATABASE_CA_FILE=
SUPABASE_URL=
# The worker's own Storage account (scripts/setup-storage-identity.mjs). It can read
# a document only while its ingestion or purge holds a lease. Never the secret key.
SUPABASE_PUBLISHABLE_KEY=
AGENTONIC_STORAGE_EMAIL=
AGENTONIC_STORAGE_PASSWORD=
VOYAGE_API_KEY=
# Set only to the total explicitly authorized amount, then run setup:rag --budget.
AGENTONIC_VOYAGE_SPEND_CAP_USD=0

OPENAI_API_KEY=
# Separate total cap for this RAG preview ledger; coordinate with other OpenAI consumers.
AGENTONIC_OPENAI_RAG_SPEND_CAP_USD=0

# Optional: immutable local runtime artifact root (default: ../../.local/runtime from the worker app)
AGENTONIC_RUNTIME_ROOT=

# Enable only after migration 28 and a reviewed benchmark; propagate to all workers.
AGENTONIC_RERANK_ENABLED=false

# Platform-owned public web Search/Fetch. Configure with scripts/setup-web.mjs.
BROWSERBASE_API_KEY=

# Gmail tools in private previews. Copied here by scripts/setup-gmail.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3101/api/connections/google/callback
AGENTONIC_CONNECTION_KEY=
# Only during a key rotation (pnpm connections:rotate-key).
# AGENTONIC_CONNECTION_STANDBY_KEYS=
