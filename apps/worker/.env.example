# Server-only worker configuration; never copy secret keys into the web apps.
DATABASE_URL=
AGENTONIC_DATABASE_CA_FILE=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
VOYAGE_API_KEY=
# Set only to the total explicitly authorized amount, then run setup:rag --budget.
AGENTONIC_VOYAGE_SPEND_CAP_USD=0

OPENAI_API_KEY=
# Separate total cap for this RAG preview ledger; coordinate with other OpenAI consumers.
AGENTONIC_OPENAI_RAG_SPEND_CAP_USD=0

# Optional: immutable local runtime artifact root (default: ../../.local/runtime from the worker app)
AGENTONIC_RUNTIME_ROOT=
