# Bootstrap-only. Copy to .env.bootstrap.local; never pass these credentials to Next.js.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
AGENTONIC_BOOTSTRAP_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres"
AGENTONIC_DATABASE_CA_FILE="/absolute/path/to/verified/supabase-ca.crt"
AGENTONIC_BOOTSTRAP_STAFF_EMAIL=""
AGENTONIC_BOOTSTRAP_CUSTOMER_A_OWNER_EMAIL=""
AGENTONIC_BOOTSTRAP_CUSTOMER_A_COLLEAGUE_EMAIL=""
AGENTONIC_BOOTSTRAP_CUSTOMER_B_OWNER_EMAIL=""
# Bootstrap only: creates the worker's Storage account and backs the live checks.
SUPABASE_SECRET_KEY=""
