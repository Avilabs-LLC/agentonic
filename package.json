{
  "name": "agentonic",
  "version": "0.53.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentonic/admin --filter @agentonic/customer --filter @agentonic/worker dev",
    "dev:admin": "pnpm --filter @agentonic/admin dev",
    "dev:customer": "pnpm --filter @agentonic/customer dev",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "lint": "pnpm -r lint && eslint scripts tests vitest.config.ts",
    "test": "vitest run",
    "db:generate": "pnpm --filter @agentonic/database generate",
    "db:validate": "pnpm --filter @agentonic/database validate",
    "db:migrate": "node scripts/migrate.mjs",
    "setup:database": "node scripts/provision-database.mjs",
    "setup:accounts": "node scripts/bootstrap-accounts.mjs",
    "skeletons:check": "node scripts/skeleton-audit.mjs check",
    "skeletons:update": "node scripts/skeleton-audit.mjs update",
    "db:check": "node scripts/check-database.mjs",
    "db:check-prisma": "tsx --conditions=react-server scripts/check-prisma.ts",
    "version:check": "node scripts/versioning.mjs check",
    "db:check-access": "node scripts/check-access.mjs",
    "setup:storage": "node scripts/setup-storage.mjs",
    "setup:storage-identity": "node scripts/setup-storage-identity.mjs",
    "setup:auth-hook": "node scripts/setup-auth-hook.mjs",
    "setup:google-reviewer": "node scripts/setup-google-reviewer.mjs",
    "setup:template": "node scripts/publish-authoring-template.mjs",
    "db:check-authoring": "node scripts/check-authoring.mjs",
    "db:check-page-reads": "node scripts/check-page-reads.mjs",
    "dev:worker": "pnpm --filter @agentonic/worker dev",
    "setup:rag": "node scripts/setup-rag.mjs",
    "rag:check-live": "node scripts/check-rag-live.mjs --live",
    "setup:preview": "node scripts/setup-preview.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "runtime:install": "node scripts/install-runtime.mjs",
    "preview:check-live": "node scripts/check-preview-live.mjs --live",
    "setup:evaluation": "node scripts/setup-evaluation.mjs",
    "package:evaluation": "node scripts/package-evaluation.mjs",
    "dev:evaluation": "pnpm --filter @agentonic/worker exec tsx src/evaluation-main.ts",
    "evaluation:check-live": "node scripts/check-evaluation-live.mjs --live",
    "setup:staging": "node scripts/setup-staging.mjs",
    "package:staging": "node scripts/package-staging.mjs",
    "dev:staging": "node scripts/start-staging.mjs",
    "staging:reverify": "node --import tsx scripts/staging-registrations/run.mjs",
    "staging:restart-window": "node scripts/install-restart-window.mjs",
    "vm:allow-ssh": "node scripts/allow-ssh.mjs",
    "platform:install": "node scripts/install-platform.mjs",
    "platform:smoke": "node scripts/smoke-platform.mjs",
    "hosted:check": "node scripts/check-hosted.mjs",
    "connections:rotate-key": "node --import tsx scripts/rotate-connection-key.mjs",
    "rag:benchmark": "tsx scripts/rag-benchmark/run.ts",
    "web:benchmark": "node --import tsx scripts/web-benchmark/run.mjs --live",
    "models:benchmark": "node --import tsx scripts/model-benchmark/run.mjs --live"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/node": "^22",
    "@types/pg": "^8.15.5",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "pg": "^8.16.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
